{
  "name": "hob",
  "description": "Hob: a private personal agent on Cloudflare, with Pi Durable running the agent loop inside a Durable Object.",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types src/worker-configuration.d.ts --include-runtime false --strict-vars false",
    "test": "vitest run --config test/vitest.config.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-durable": "1.0.4",
    "@phosphor-icons/react": "2.1.10",
    "agents": "0.26.0",
    "jose": "6.2.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "streamdown": "2.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.0",
    "@cloudflare/vitest-pool-workers": "0.19.1",
    "@cloudflare/workers-types": "5.20261007.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "4.1.11",
    "wrangler": "4.148.0"
  },
  "pnpm": {
    "overrides": {
      "@earendil-works/chord": "1.0.4",
      "@earendil-works/pi-ai": "1.0.4",
      "@earendil-works/pi-telemetry": "1.0.4"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ],
    "ignoredBuiltDependencies": [
      "@google/genai",
      "core-js-pure",
      "protobufjs"
    ]
  }
}
